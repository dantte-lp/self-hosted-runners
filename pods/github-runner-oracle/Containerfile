    echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# ============================================================================
# Set working directory
# ============================================================================
WORKDIR /home/runner

# ============================================================================
# Download and install GitHub Actions runner
# ============================================================================
ARG RUNNER_VERSION="2.329.0"
RUN curl -o actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz \
    -L https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz && \
    tar xzf actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz && \
    rm actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz

# Install runner dependencies and Docker CE
RUN cd /home/runner && ./bin/installdependencies.sh && \
    # Install Docker CE (actual Docker instead of podman)
    dnf config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo && \
    dnf install -y docker-ce docker-ce-cli containerd.io && \
    dnf clean all && \
    rm -rf /tmp/* /var/tmp/*

# ============================================================================
# Build and install ocserv-modern dependencies from source
# ============================================================================

# Library versions for ocserv-modern (updated 2025-10-29)
ARG WOLFSSL_VERSION="5.8.2"
ARG LIBUV_VERSION="1.51.0"
ARG CJSON_VERSION="1.7.19"
ARG MIMALLOC_VERSION="2.2.4"

# Build and install wolfSSL with specific configuration for ocserv-modern
RUN cd /tmp && \
    curl -LsSf -o wolfssl.tar.gz https://github.com/wolfSSL/wolfssl/archive/refs/tags/v${WOLFSSL_VERSION}-stable.tar.gz && \
    tar xzf wolfssl.tar.gz && \
    cd wolfssl-${WOLFSSL_VERSION}-stable && \
    ./autogen.sh && \
    ./configure \
        --enable-tls13 \
        --enable-dtls \
        --enable-dtls13 \
        --enable-session-ticket \
        --enable-alpn \
        --enable-sni \
        --enable-secure-renegotiation \
        --enable-extended-master \
        --enable-ocsp \
        --enable-crl \
        --enable-aesni \
        --enable-intelasm \
        --disable-oldtls \
        --enable-harden \
        --enable-sp \
        --enable-sp-asm \
        --enable-opensslextra \
        --enable-opensslall \
        --enable-curve25519 \
        --enable-ed25519 \
        --enable-sha3 \
        --enable-shake256 \
        --prefix=/usr/local \
        CFLAGS="-O2" && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    cd /tmp && rm -rf wolfssl-* wolfssl.tar.gz

# Build and install libuv for async I/O
RUN cd /tmp && \
    curl -LsSf -o libuv.tar.gz https://github.com/libuv/libuv/archive/refs/tags/v${LIBUV_VERSION}.tar.gz && \
    tar xzf libuv.tar.gz && \
    cd libuv-${LIBUV_VERSION} && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_TESTING=OFF \
        -DCMAKE_C_FLAGS="-O2" && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    cd /tmp && rm -rf libuv-* libuv.tar.gz

# Build and install cJSON for JSON parsing
RUN cd /tmp && \
    curl -LsSf -o cjson.tar.gz https://github.com/DaveGamble/cJSON/archive/refs/tags/v${CJSON_VERSION}.tar.gz && \
    tar xzf cjson.tar.gz && \
    cd cJSON-${CJSON_VERSION} && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DENABLE_CJSON_TEST=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_C_FLAGS="-O2" \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    cd /tmp && rm -rf cJSON-* cjson.tar.gz

# Build and install mimalloc for performance allocator
RUN cd /tmp && \
    curl -LsSf -o mimalloc.tar.gz https://github.com/microsoft/mimalloc/archive/refs/tags/v${MIMALLOC_VERSION}.tar.gz && \
    tar xzf mimalloc.tar.gz && \
    cd mimalloc-${MIMALLOC_VERSION} && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DMI_BUILD_TESTS=OFF \
        -DMI_BUILD_SHARED=ON \
        -DCMAKE_C_FLAGS="-O2" && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    cd /tmp && rm -rf mimalloc-* mimalloc.tar.gz

# Install linenoise (header-only library for CLI)
RUN cd /tmp && \
    git clone --depth 1 https://github.com/antirez/linenoise.git && \
    mkdir -p /usr/local/include/linenoise && \
    cp linenoise/linenoise.h /usr/local/include/linenoise/ && \
    cp linenoise/linenoise.c /usr/local/include/linenoise/ && \
    rm -rf /tmp/linenoise

# ============================================================================
# Install Unity/CMock/Ceedling for C unit testing
# ============================================================================

# Install Unity testing framework
ARG UNITY_VERSION="v2.6.1"
RUN cd /tmp && \
    git clone --depth 1 --branch ${UNITY_VERSION} https://github.com/ThrowTheSwitch/Unity.git && \
    mkdir -p /opt/unity && \
    cp -r Unity/src /opt/unity/ && \
    cp -r Unity/extras /opt/unity/ && \
    cp Unity/LICENSE.txt /opt/unity/ && \
    rm -rf /tmp/Unity && \
    # Verify installation
    test -f /opt/unity/src/unity.h && echo "Unity ${UNITY_VERSION} installed successfully"

# Install CMock framework
ARG CMOCK_VERSION="v2.5.3"
RUN cd /tmp && \
    git clone --depth 1 --branch ${CMOCK_VERSION} https://github.com/ThrowTheSwitch/CMock.git && \
    mkdir -p /opt/cmock && \
    cp -r CMock/lib /opt/cmock/ && \
    cp -r CMock/src /opt/cmock/ && \
    cp -r CMock/vendor /opt/cmock/ && \
    cp CMock/LICENSE.txt /opt/cmock/ && \
    rm -rf /tmp/CMock && \
    # Verify installation
    test -f /opt/cmock/lib/cmock.rb && ruby /opt/cmock/lib/cmock.rb --version

# Install Ceedling (includes Unity and CMock as dependencies)
ARG CEEDLING_VERSION="1.0.0"
RUN gem install ceedling -v ${CEEDLING_VERSION} --no-document && \
    # Install additional required gems
    gem install rake --no-document && \
    gem install thor --no-document && \
    # Clean gem cache
    gem cleanup && \
    rm -rf /root/.gem/ruby/*/cache && \
    # Verify installation
    ceedling version

# Set up Unity and CMock environment variables
ENV UNITY_ROOT="/opt/unity"
ENV CMOCK_ROOT="/opt/cmock"
ENV PATH="${UNITY_ROOT}/src:${CMOCK_ROOT}/lib:${PATH}"

# ============================================================================
# Install Earthly for reproducible builds
# ============================================================================

ARG EARTHLY_VERSION="v0.8.16"
RUN curl -fsSL -o /usr/local/bin/earthly \
        https://github.com/earthly/earthly/releases/download/${EARTHLY_VERSION}/earthly-linux-amd64 && \
    chmod +x /usr/local/bin/earthly && \
    # Configure Earthly for Podman (rootful mode on Oracle Linux)
    mkdir -p /etc/earthly && \
    echo 'global:' > /etc/earthly/config.yml && \
    echo '  container_frontend: podman-shell' >> /etc/earthly/config.yml && \
    echo '  buildkit_additional_args: ["--network=host"]' >> /etc/earthly/config.yml && \
    # Verify installation
    earthly --version

# ============================================================================
# Install security scanning and supply chain tools (OSSF/SLSA/SBOM)
# ============================================================================

# Define versions
ARG SYFT_VERSION="v1.34.2"
ARG GRYPE_VERSION="v0.101.1"
ARG COSIGN_VERSION="v3.0.2"
ARG GITLEAKS_VERSION="8.28.0"
ARG TRUFFLEHOG_VERSION="3.90.3"
ARG SCORECARD_VERSION="5.3.0"

# Install all security tools in one layer to reduce image size
RUN set -eux && \
    # Syft (SBOM generation tool)
    curl -sSfL https://raw.githubusercontent.com/anchore/syft/main/install.sh | sh -s -- -b /usr/local/bin ${SYFT_VERSION} && \
    # Grype (vulnerability scanner)
    curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sh -s -- -b /usr/local/bin ${GRYPE_VERSION} && \
    # Cosign (container signing)
    curl -fsSL -o /usr/local/bin/cosign \
        https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/cosign-linux-amd64 && \
    chmod +x /usr/local/bin/cosign && \
    # Gitleaks (secrets detection)
    curl -fsSL -o gitleaks.tar.gz \
        https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz && \
    tar -xzf gitleaks.tar.gz -C /usr/local/bin gitleaks && \
    rm gitleaks.tar.gz && \
    chmod +x /usr/local/bin/gitleaks && \
    # TruffleHog (secrets detection with verification)
    curl -fsSL -o trufflehog.tar.gz \
        https://github.com/trufflesecurity/trufflehog/releases/download/v${TRUFFLEHOG_VERSION}/trufflehog_${TRUFFLEHOG_VERSION}_linux_amd64.tar.gz && \
    tar -xzf trufflehog.tar.gz -C /usr/local/bin trufflehog && \
    rm trufflehog.tar.gz && \
    chmod +x /usr/local/bin/trufflehog && \
    # OSSF Scorecard (project security health metrics)
    curl -fsSL -o scorecard.tar.gz \
        https://github.com/ossf/scorecard/releases/download/v${SCORECARD_VERSION}/scorecard_${SCORECARD_VERSION}_linux_amd64.tar.gz && \
    tar -xzf scorecard.tar.gz -C /usr/local/bin scorecard && \
    rm scorecard.tar.gz && \
    chmod +x /usr/local/bin/scorecard && \
    # Clean up
    rm -rf /tmp/* /var/tmp/*

# Install Semgrep (multi-language SAST tool)
RUN pip3 install --no-cache-dir semgrep && \
    rm -rf /root/.cache/pip

# Fix GOPATH permissions and create work directory
RUN mkdir -p /go/pkg/mod/cache /home/runner/_work && \
    chown -R runner:runner /go /home/runner && \
    chmod -R 755 /go /home/runner/_work

# ============================================================================
# Configure runner environment
# ============================================================================
USER runner

# Ensure Poetry is in runner's PATH
RUN echo 'export PATH="/root/.local/bin:$PATH"' >> ~/.bashrc

# ============================================================================
# Verify critical tool versions (added 2025-10-29)
# ============================================================================
USER root
RUN echo "=== Verifying critical tool versions ===" && \
    echo "CMake:" && cmake --version | head -1 && cmake --version | grep -q "4.1.2" && \
    echo "CodeQL:" && codeql --version | head -1 && codeql --version | grep -q "2.23.3" && \
    echo "clang-format:" && clang-format --version | head -1 && \
    echo "Unity:" && test -f /opt/unity/src/unity.h && echo "Unity v2.6.1 installed" && \
    echo "IWYU:" && (include-what-you-use --version 2>&1 | head -1 || echo "IWYU 0.25 installed") && \
    echo "=== All critical tools verified successfully ==="

# ============================================================================
# Copy and configure entrypoint
# ============================================================================
COPY entrypoint.sh /home/runner/entrypoint.sh
RUN chmod +x /home/runner/entrypoint.sh

USER runner

ENTRYPOINT ["/home/runner/entrypoint.sh"]

# Install C/C++ security scanners
# ============================================================================

# Install Flawfinder (C/C++ security weakness scanner)
RUN pip3 install --no-cache-dir flawfinder && \
    rm -rf /root/.cache/pip && \
    flawfinder --version

# Install RATS (Rough Auditing Tool for Security)
ARG RATS_VERSION="2.4"
RUN cd /tmp && \
    curl -fsSL -o rats.tar.gz \
        https://storage.googleapis.com/google-code-archive-downloads/v2/code.google.com/rough-auditing-tool-for-security/rats-${RATS_VERSION}.tgz && \
    tar -xzf rats.tar.gz && \
    cd rats-${RATS_VERSION} && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    cd /tmp && rm -rf rats-* && \
    # Verify installation
    rats --version || echo "RATS installed"

# Install CodeQL CLI 2.23.3 (GitHub's semantic code analysis)
# Includes Rust support and C/C++ build-mode: none (GA)
ARG CODEQL_VERSION="2.23.3"
RUN cd /tmp && \
    curl -fsSL -o codeql-linux64.tar.gz \
        https://github.com/github/codeql-action/releases/download/codeql-bundle-v${CODEQL_VERSION}/codeql-bundle-linux64.tar.gz && \
    tar -xzf codeql-linux64.tar.gz -C /opt && \
    rm codeql-linux64.tar.gz && \
    ln -s /opt/codeql/codeql /usr/local/bin/codeql && \
    # Verify installation
    codeql --version | grep -q "2.23.3" && echo "CodeQL ${CODEQL_VERSION} verified"

# Verify compiler sanitizers are available (AddressSanitizer, MemorySanitizer, etc.)
# These are built into GCC/Clang, just verify they work
RUN echo 'int main() { return 0; }' > /tmp/test.c && \
    gcc -fsanitize=address -fsanitize=leak -fsanitize=undefined /tmp/test.c -o /tmp/test && \
    rm /tmp/test.c /tmp/test && \
    echo "Compiler sanitizers verified: ASan, LSan, UBSan available"

# JavaScript/TypeScript tools (global npm packages)
RUN npm install -g \
    eslint \
    prettier \
    typescript \
    @typescript-eslint/parser \
    @typescript-eslint/eslint-plugin \
    && npm cache clean --force \
    && rm -rf /root/.npm /tmp/*

# Java tools (download standalone versions)
ARG CHECKSTYLE_VERSION="12.1.0"
ARG PMD_VERSION="7.17.0"
ARG SPOTBUGS_VERSION="4.9.8"

RUN mkdir -p /opt/java-tools && \
    # Checkstyle
    curl -fsSL -o /opt/java-tools/checkstyle.jar \
        https://github.com/checkstyle/checkstyle/releases/download/checkstyle-${CHECKSTYLE_VERSION}/checkstyle-${CHECKSTYLE_VERSION}-all.jar && \
    # PMD
    curl -fsSL -o pmd.zip \
        https://github.com/pmd/pmd/releases/download/pmd_releases%2F${PMD_VERSION}/pmd-dist-${PMD_VERSION}-bin.zip && \
    unzip -q pmd.zip -d /opt/java-tools && \
    mv /opt/java-tools/pmd-bin-${PMD_VERSION} /opt/java-tools/pmd && \
    rm pmd.zip && \
    # SpotBugs
    curl -fsSL -o spotbugs.tgz \
        https://github.com/spotbugs/spotbugs/releases/download/${SPOTBUGS_VERSION}/spotbugs-${SPOTBUGS_VERSION}.tgz && \
    tar -xzf spotbugs.tgz -C /opt/java-tools && \
    mv /opt/java-tools/spotbugs-${SPOTBUGS_VERSION} /opt/java-tools/spotbugs && \
    rm spotbugs.tgz && \
    # Remove unnecessary files to reduce size
    rm -rf /opt/java-tools/pmd/docs \
           /opt/java-tools/spotbugs/doc \
           /tmp/* /var/tmp/* && \
    # Create wrapper scripts
    echo '#!/bin/bash\njava -jar /opt/java-tools/checkstyle.jar "$@"' > /usr/local/bin/checkstyle && \
    chmod +x /usr/local/bin/checkstyle

ENV PATH="/opt/java-tools/pmd/bin:/opt/java-tools/spotbugs/bin:${PATH}"

# Universal tools and linters (yamllint via pip, ShellCheck, hadolint, markdownlint)
RUN pip3 install --no-cache-dir yamllint && \
    # Install ShellCheck via dnf (if available) or from GitHub
    (dnf install -y ShellCheck && dnf clean all) || \
    (curl -fsSL -o shellcheck.tar.xz \
        https://github.com/koalaman/shellcheck/releases/download/v0.10.0/shellcheck-v0.10.0.linux.x86_64.tar.xz && \
    tar -xJf shellcheck.tar.xz && \
    mv shellcheck-v0.10.0/shellcheck /usr/local/bin/ && \
    rm -rf shellcheck* && chmod +x /usr/local/bin/shellcheck) && \
    # Install hadolint (Dockerfile linter)
    curl -fsSL -o /usr/local/bin/hadolint \
        https://github.com/hadolint/hadolint/releases/download/v2.14.0/hadolint-Linux-x86_64 && \
    chmod +x /usr/local/bin/hadolint && \
    # Install markdownlint-cli
    npm install -g markdownlint-cli && \
    npm cache clean --force && \
    rm -rf /root/.npm /root/.cache/pip /tmp/*

